#!/bin/sh
# Pre-commit gate generated by bootstrap-orchestrateur v2.
# Fast lane: branch guard + safety net + static analysis. Tests run in pre-push.
set -e

# During an orchestrated run, only the run branch and worktree task branches
# accept commits. Anything else is refused, whatever the main branch is called.
ACTIVE="docs/plans/ACTIVE.md"
if [ -f "$ACTIVE" ]; then
  run=$(sed -n 's/^Run:[[:space:]]*\([^|]*\).*/\1/p' "$ACTIVE" | head -n 1 | sed 's/[[:space:]]*$//')
  if [ -n "$run" ] && [ "$run" != "aucun" ]; then
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo HEAD)
    case "$branch" in
      orch/*|task/*) ;;
      *)
        echo "Run '$run' en cours: commit autorise seulement sur orch/* ou task/*, pas sur '$branch'." >&2
        echo "Voir docs/ORCHESTRATOR.md section 11. Contournement volontaire: git commit --no-verify." >&2
        exit 1
        ;;
    esac
  fi
fi

# Safety net for writes the Claude hook cannot see (Bash redirections, manual edits):
# forbidden dashes on staged added lines, ACTIVE.md line cap.
# In a linked worktree the project .claude/ may be absent (gitignored, or simply
# not checked out): fall back to the guard of the main worktree.
GUARD=".claude/hooks/orchestrator-guard.mjs"
if [ ! -f "$GUARD" ]; then
  COMMON=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
  [ -n "$COMMON" ] && GUARD="$(dirname "$COMMON")/.claude/hooks/orchestrator-guard.mjs"
fi
if [ -f "$GUARD" ]; then
  if command -v node >/dev/null 2>&1; then
    node "$GUARD" --staged
  else
    echo "Attention: node introuvable, filet de securite du pre-commit ignore." >&2
  fi
fi

# Analyse statique : dans le conteneur Docker 'backend' s'il tourne, sinon en local.
GATE_SERVICE=backend
. "$(dirname "$0")/gate-lib.sh"
run_gate npx --no-install tsc --noEmit
# Lint limite aux fichiers indexes (dette existante : environ 2 000 erreurs sur le projet).
FICHIERS=$(fichiers_indexes '^(src|apps|libs|test)/.*\.ts$')
if [ -n "$FICHIERS" ]; then
  # shellcheck disable=SC2086
  run_gate npx --no-install eslint $FICHIERS
fi
